# ============================================================
# CPublishr Backend — Environment Configuration Reference
# Copy this file to .env and fill in your values.
# ============================================================

# ------------------------------------------------------------
# App
# ------------------------------------------------------------
APP_NAME=CPublishr API
ENV=local                         # local | production
API_V1_PREFIX=/api/v1

# ------------------------------------------------------------
# Database (required)
# ------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://username:password@host:5432/dbname
DB_AUTO_CREATE=true               # auto-create tables on startup (disable in production)

# ------------------------------------------------------------
# Auth (required)
# ------------------------------------------------------------
# Generate with: openssl rand -hex 32
AUTH_JWT_SECRET=replace-with-a-long-random-secret
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------
# CORS
# In production, set to your actual frontend URL(s), comma-separated
# ------------------------------------------------------------
CORS_ALLOW_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173

# ------------------------------------------------------------
# LLM provider — "azure" (default) or "openai"
# ------------------------------------------------------------
LLM_PROVIDER=azure

# Required if LLM_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_SUBSCRIPTION_KEY=replace-me
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Required if LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Enable LLM-generated text artifact bodies (off by default)
ARTIFACT_TEXT_LLM_ENABLED=false

# ------------------------------------------------------------
# Image generation — Azure OpenAI DALL-E 3 (optional)
# Leave empty to run in simulated mode
# ------------------------------------------------------------
AZURE_OPENAI_IMAGE_ENDPOINT=     # defaults to AZURE_OPENAI_ENDPOINT if empty
AZURE_OPENAI_IMAGE_DEPLOYMENT=
AZURE_OPENAI_IMAGE_API_VERSION=2024-02-01

# ------------------------------------------------------------
# Video generation — Azure Sora (optional)
# Leave empty to run in simulated mode
# ------------------------------------------------------------
AZURE_SORA_ENDPOINT=
AZURE_SORA_API_KEY=
AZURE_SORA_API_VERSION=preview
AZURE_SORA_DEPLOYMENT_NAME=      # e.g. sora-preview

# ------------------------------------------------------------
# Azure Blob Storage — voice profile dataset ingestion (optional)
# ------------------------------------------------------------
AZURE_STORAGE_CONNECTION_STRING=
AZURE_PROFILE_ENTRIES_CONTAINER=profile-entries

# ------------------------------------------------------------
# Azure Blob Storage — generated artifacts (optional)
# ------------------------------------------------------------
AZURE_ARTIFACTS_ENABLED=false
AZURE_ARTIFACTS_CONTAINER=artifacts
AZURE_ARTIFACTS_BLOB_PREFIX=artifacts
AZURE_ARTIFACTS_PUBLIC_READ=false
AZURE_ARTIFACTS_SAS_TTL_MINUTES=60

# ------------------------------------------------------------
# Azure Blob Storage — prompt audit logs (optional)
# ------------------------------------------------------------
AZURE_PROMPT_LOGGING_ENABLED=true
AZURE_PROMPTS_CONTAINER=qc-prompts
AZURE_PROMPTS_BLOB_PREFIX=

# ------------------------------------------------------------
# Redis (optional — reserved for future queue/cache features)
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------
# LinkedIn publishing (optional)
# ------------------------------------------------------------
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=             # e.g. urn:li:person:* or urn:li:organization:*
LINKEDIN_API_VERSION=202602
LINKEDIN_HTTP_TIMEOUT_SECONDS=60

# ------------------------------------------------------------
# Output path for save-to-publish (optional)
# Examples:
#   Local:      /tmp/output  or  C:/temp/output
#   Azure Blob: azure://<container>/<prefix>
# ------------------------------------------------------------
OUTPUT_PATH=
