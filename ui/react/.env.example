# API base URL for the backend.
#
# Local dev: leave unset (or set to http://127.0.0.1:8010) — Vite proxy handles /api routing.
# Production (Render): set to your backend service URL, e.g.:
#   VITE_API_BASE_URL=https://cpublishr-backend.onrender.com
#
# This value is baked into the static build at build time.
VITE_API_BASE_URL=
